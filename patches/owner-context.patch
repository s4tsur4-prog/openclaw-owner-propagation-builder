+/** Projects an existing decision, never deriving owner authority from identity or session state. */
+export function buildAgentHookContextOwnerFields(
+  params: AgentHookOwnerInput,
+): Pick<PluginHookAgentContext, "senderIsOwner"> {
+  // Scheduled continuations can use trigger=user, and child runs can retain
+  // requester metadata. Neither is a fresh owner-authorized user turn.
+  if (
+    (params.trigger !== undefined && params.trigger !== "user") ||
+    (params.inputProvenance !== undefined && params.inputProvenance.kind !== "external_user") ||
+    (params.bootstrapContextRunKind !== undefined &&
+      params.bootstrapContextRunKind !== "default") ||
+    params.spawnedBy ||
+    params.lane === "subagent" ||
+    typeof params.senderIsOwner !== "boolean"
+  ) {
+    return {};
+  }
+  return { senderIsOwner: params.senderIsOwner };
