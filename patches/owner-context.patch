@@ -0,0 +1,116 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { buildAgentHookContextChannelFields } from "../../plugins/hook-agent-context.js";
+import type { OpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+import { makeAttemptResult } from "./run.overflow-compaction.fixture.js";
+import {
+  createOverflowRunParams,
+  loadRunOverflowCompactionHarness,
+  mockedBuildEmbeddedRunPayloads,
+  mockedGlobalHookRunner,
+  mockedRunEmbeddedAttempt,
+  resetSharedRunIntegrationHarnessMocks,
+  useOpenAIPlatformAuthFixture,
+} from "./run.overflow-compaction.harness.js";
+import type { RunEmbeddedAgentInternalParams } from "./run/internal-params.js";
+
+const { runEmbeddedAgent } = await loadRunOverflowCompactionHarness();
+let state: OpenClawTestState;
+
+describe("runEmbeddedAgent current-run owner hook authority", () => {
+  beforeEach(async () => {
+    resetSharedRunIntegrationHarnessMocks();
+    const { createOpenClawTestState } = await import("../../test-utils/openclaw-test-state.js");
+    state = await createOpenClawTestState({ label: "owner-hook-context" });
+    useOpenAIPlatformAuthFixture();
+    mockedGlobalHookRunner.hasHooks.mockImplementation((name) => name === "before_model_resolve");
+    mockedBuildEmbeddedRunPayloads.mockReturnValue([{ text: "OK" }]);
+    mockedRunEmbeddedAttempt.mockResolvedValue(makeAttemptResult({ assistantTexts: ["OK"] }));
+  });
+
+  afterEach(async () => {
+    await state?.cleanup();
+  });
+
+  async function run(overrides: Partial<RunEmbeddedAgentInternalParams> = {}) {
+    await runEmbeddedAgent({
+      ...createOverflowRunParams(state),
+      provider: "openai",
+      model: "test-model",
+      messageProvider: "telegram",
+      agentAccountId: "account-a",
+      senderId: "sender-a",
+      trigger: "user",
+      ...overrides,
+    });
+    expect(mockedRunEmbeddedAttempt).toHaveBeenCalled();
+    const context = mockedGlobalHookRunner.runBeforeModelResolve.mock.lastCall?.[1];
+    expect(context).toBeDefined();
+    const dispatchedAttempt = mockedRunEmbeddedAttempt.mock.lastCall?.[0];
+    expect(dispatchedAttempt).toBeDefined();
+    expect(buildAgentHookContextChannelFields(dispatchedAttempt!).senderIsOwner).toBe(
+      context!.senderIsOwner,
+    );
+    return context!;
+  }
+
+  it.each([true, false, undefined])(
+    "projects the current inbound decision %s before model resolution",
+    async (senderIsOwner) => {
+      const context = await run({ senderIsOwner });
+      expect(context.senderIsOwner).toBe(senderIsOwner);
+      expect(context).toMatchObject({ accountId: "account-a", senderId: "sender-a" });
+    },
+  );
+
+  it("does not retain owner authority across runs in the same resumed session", async () => {
+    const owner = await run({ runId: "owner", senderIsOwner: true });
+    const nonOwner = await run({ runId: "non-owner", senderId: "sender-b", senderIsOwner: false });
+    const unknown = await run({ runId: "resumed-unknown", senderIsOwner: undefined });
+    expect(owner.senderIsOwner).toBe(true);
+    expect(nonOwner.senderIsOwner).toBe(false);
+    expect(unknown.senderIsOwner).toBeUndefined();
+    expect(mockedGlobalHookRunner.runBeforeModelResolve).toHaveBeenCalledTimes(3);
+  });
+
+  it("does not borrow authority across channel or account boundaries", async () => {
+    const owner = await run({ runId: "account-a-owner", senderIsOwner: true });
+    const otherAccount = await run({
+      runId: "account-b",
+      agentAccountId: "account-b",
+      senderIsOwner: false,
+    });
+    const otherChannel = await run({ runId: "other-channel", messageProvider: "discord" });
+    expect(owner).toMatchObject({ accountId: "account-a", senderIsOwner: true });
+    expect(otherAccount).toMatchObject({ accountId: "account-b", senderIsOwner: false });
+    expect(otherChannel.messageProvider).toBe("discord");
+    expect(otherChannel.senderIsOwner).toBeUndefined();
+  });
+
+  it.each(["cron", "heartbeat", "manual", "memory", "overflow"] as const)(
+    "withholds stale owner input on a %s run",
+    async (trigger) => {
+      expect((await run({ trigger, senderIsOwner: true })).senderIsOwner).toBeUndefined();
+    },
+  );
+
+  it.each([
+    { kind: "internal_system", sourceTool: "main_session_restart_recovery" },
+    { kind: "inter_session", sourceTool: "sessions_spawn" },
+    { kind: "internal_system", sourceTool: "internal-handoff" },
+  ] as const)("withholds owner authority for $sourceTool provenance", async (inputProvenance) => {
+    expect((await run({ inputProvenance, senderIsOwner: true })).senderIsOwner).toBeUndefined();
+  });
+
+  it.each([
+    { bootstrapContextRunKind: "cron" },
+    { spawnedBy: "agent:main:parent" },
+    { lane: "subagent" },
+  ] satisfies Partial<RunEmbeddedAgentInternalParams>[])(
+    "withholds inherited authority for internal run facts %j",
+    async (facts) => {
+      expect(
+        (await run({ ...facts, trigger: "user", senderIsOwner: true })).senderIsOwner,
+      ).toBeUndefined();
+    },
+  );
+});
