new file mode 100644
index 00000000..535061a4
--- /dev/null
+++ b/extensions/codex/src/app-server/before-agent-run.ts
@@ -0,0 +1,57 @@
+import { resolveBlockMessage } from "openclaw/plugin-sdk/agent-harness-runtime";
+import type { CodexAttemptContext } from "./run-attempt-context.js";
+
+/** A policy terminal, never a provider/model availability failure. */
+export class CodexBeforeAgentRunBlockedError extends Error {
+  constructor(
+    readonly blockedBy: string,
+    message: string,
+  ) {
+    super(message);
+    this.name = "CodexBeforeAgentRunBlockedError";
+  }
+}
+
+/** Recheck the current host policy at every native submission, including retries. */
+export async function assertCodexBeforeAgentRunAllowed(
+  context: CodexAttemptContext,
+  input: { prompt: string; systemPrompt?: string; historyMessages: unknown[] },
+  submittedModel: { modelProviderId?: string; modelId?: string },
+): Promise<void> {
+  const { hookRunner } = context;
+  // The startup binding may differ from the requested model. Policy must see
+  // the exact submission tuple, without changing other lifecycle snapshots.
+  const hookContext = { ...context.hookContext, ...submittedModel };
+  if (!hookRunner?.hasHooks("before_agent_run")) {
+    return;
+  }
+  let result: Awaited<ReturnType<typeof hookRunner.runBeforeAgentRun>>;
+  try {
+    result = await hookRunner.runBeforeAgentRun(
+      {
+        prompt: input.prompt,
+        systemPrompt: input.systemPrompt,
+        messages: structuredClone(input.historyMessages),
+        channelId: hookContext.channelId,
+        accountId: hookContext.accountId,
+        senderId: hookContext.senderId,
+        senderIsOwner: hookContext.senderIsOwner,
+      },
+      hookContext,
+    );
+  } catch {
+    throw new CodexBeforeAgentRunBlockedError(
+      "before_agent_run",
+      resolveBlockMessage(
+        { outcome: "block", reason: "before_agent_run hook failed" },
+        { blockedBy: "before_agent_run" },
+      ),
+    );
+  }
+  if (result?.decision.outcome === "block") {
+    throw new CodexBeforeAgentRunBlockedError(
+      result.pluginId,
+      resolveBlockMessage(result.decision, { blockedBy: result.pluginId }),
+    );
+  }
+}
